<component type="desktop-application">
  <id>io.github.dionarley.voluta</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Voluta</name>
  <summary>Geometria e dimensionamento de sopradores centrífugos</summary>

  <description>
    <p>
      Voluta é uma ferramenta Python para projetar e visualizar sopradores
      centrífugos. O aplicativo combina o traçado geométrico da voluta em
      espiral de Arquimedes com equações de dimensionamento aerodinâmico.
    </p>
    <ul>
      <li>Pré-visualização do perfil da voluta e do rotor.</li>
      <li>Cálculo de velocidade periférica, diâmetros e potência no eixo.</li>
      <li>Exportação de imagens em PNG, SVG e PDF.</li>
      <li>Exportação do dimensionamento em JSON.</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.dionarley.voluta.desktop</launchable>

